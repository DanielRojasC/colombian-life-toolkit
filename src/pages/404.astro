---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="Esa dirección no existe en Tu Caja de Herramientas."
  robots="noindex"
>
  <div class="shell content-block">
    <h1>No encontramos esa página</h1>
    <p>
      La dirección no corresponde a una herramienta ni a una sección del sitio.
    </p>
    <p>
      <a href="/herramientas">Ir a las herramientas</a>
    </p>
  </div>
</BaseLayout>
