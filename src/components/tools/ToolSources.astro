---
import type { OfficialSource } from "../../infrastructure/sources/official-sources";

interface Props {
  sources: OfficialSource[];
}

const { sources } = Astro.props;
---

<section aria-labelledby="sources-title">
  <h2 id="sources-title">Fuentes</h2>
  {sources.length === 0 ? (
    <p>
      Este cálculo es matemático. No usa una tarifa oficial: los precios, tasas
      y cantidades los ingresas tú.
    </p>
  ) : (
    <ul class="source-list">
      {sources.map((source) => (
        <li>
          <a href={source.url}>{source.title}</a>
          <p>
            {source.publisher}. {source.note}
          </p>
        </li>
      ))}
    </ul>
  )}
</section>
