---
interface Item {
  name: string;
  href: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Miga de pan">
  <ol>
    {items.map((item, index) => (
      <li>
        {index === items.length - 1 ? (
          <span aria-current="page">{item.name}</span>
        ) : (
          <a href={item.href}>{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
