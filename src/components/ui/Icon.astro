---
interface Props {
  name:
    | "work"
    | "money"
    | "vehicle"
    | "home"
    | "freelance"
    | "daily"
    | "search"
    | "mark";
}

const { name } = Astro.props;
---

{name === "mark" && (
  <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
    <path fill="currentColor" d="M4 9h16v10H4z" />
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      d="M8 9V7a4 4 0 0 1 8 0v2"
    />
      <rect x="11" y="12" width="2" height="4" fill="#0f6e62" />
  </svg>
)}
{name === "work" && (
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <rect x="3" y="7" width="18" height="13" rx="2" />
    <path d="M8 7V5h8v2M3 12h18" />
  </svg>
)}
{name === "money" && (
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <rect x="3" y="6" width="18" height="12" rx="2" />
    <circle cx="12" cy="12" r="2.5" />
  </svg>
)}
{name === "vehicle" && (
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <path d="M4 15h16l-1.5-5h-13z" />
    <circle cx="7" cy="17" r="1.5" />
    <circle cx="17" cy="17" r="1.5" />
  </svg>
)}
{name === "home" && (
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <path d="M4 11 12 4l8 7v8H4z" />
    <path d="M10 19v-5h4v5" />
  </svg>
)}
{name === "freelance" && (
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <circle cx="12" cy="8" r="3" />
    <path d="M5 19c1.5-3 3.8-4.5 7-4.5S17.5 16 19 19" />
  </svg>
)}
{name === "daily" && (
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <circle cx="12" cy="12" r="8" />
    <path d="M12 8v4l3 2" />
  </svg>
)}
{name === "search" && (
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <circle cx="11" cy="11" r="6" />
    <path d="M16 16 20 20" />
  </svg>
)}
